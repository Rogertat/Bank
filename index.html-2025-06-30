  <script>
  window.adobeDataLayer = window.adobeDataLayer || [];

if(localStorage.getItem('buttonclick')){
var a = 0;
    if(a === 0){
        adobeDataLayer.push({
            'event' : 'Internal Campaign Clicks',
            'CTA' : {
                
                'name' : localStorage.getItem('buttonclick'),
				'category' : localStorage.getItem('category'),
                'title' : localStorage.getItem('title'),
               'slot' : localStorage.getItem('slot')
            }
        })
        a = 1;
		 localStorage.removeItem('category');
        localStorage.removeItem('buttonclick');
        localStorage.removeItem('title');
        localStorage.removeItem('slot');
    }
}

document.addEventListener("DOMContentLoaded", function () {
  // 1. Push saved CTA click if exists
 
$('.nav-links a').on('click',function(){
    localStorage.setItem('buttonclick',$(this).text().trim())
    localStorage.setItem('category','Header');
    localStorage.setItem('title','Header');
    localStorage.setItem('slot','N/A');
})
$('.btn-primary, .btn-secondary').on('click',function(){
    localStorage.setItem('buttonclick',$(this).text().trim())
    localStorage.setItem('category','Banner');
    localStorage.setItem('title',$(this).closest('.banner-content').find('h1').text().trim());
    localStorage.setItem('slot',$(this).closest('div.slide').find('img').attr('alt'));
})
$('button.btn').on('click',function(){
    localStorage.setItem('buttonclick',$(this).text().trim())
    localStorage.setItem('category','Buttons');
    localStorage.setItem('title',$(this).closest('.service-card').find('h3').text().trim());
    localStorage.setItem('slot','N/A');
})
});

//Search Function withresult
  document.addEventListener("DOMContentLoaded", function () {
    const urlParams = new URLSearchParams(window.location.search);
    const searchTerm = urlParams.get("search");

    if (searchTerm) {
      const pageText = document.body.innerText.toLowerCase();
      const found = pageText.includes(searchTerm.toLowerCase());

      if (found) {
        window.adobeDataLayer.push({
          event: "searcheswithResult",
          searches: {
            withResult: searchTerm
          }
        });
      }
    }
  });
// Ensure adobeDataLayer exists


// Push pageLoad event
window.adobeDataLayer.push({
 "event": "Page Load",
"pageInfo": {
"name": document.title,
"url": location.href,
"applicationStatus": "Test"
  }
});


  </script>
