      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 12px 30px;
      border: none;
      border-radius: 25px;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      transition: 0.3s ease;
    }

    .btn-primary {
      background: #ffd700;
      color: #333;
    }

    .btn-primary:hover {
      background: #ffed4e;
    }

    .btn-secondary {
      background: transparent;
      color: white;
      border: 2px solid white;
    }

    .btn-secondary:hover {
      background: white;
      color: #333;
    }

    .carousel-nav {
      position: absolute;
      bottom: 20px;
      width: 100%;
      text-align: center;
    }

    .carousel-dot {
      display: inline-block;
      width: 12px;
      height: 12px;
      background-color: white;
      opacity: 0.6;
      border-radius: 50%;
      margin: 0 5px;
      cursor: pointer;
    }

    .carousel-dot.active {
      opacity: 1;
      background-color: #ffd700;
    }

    .services {
      padding: 80px 0;
      background: #f8f9fa;
    }

    .services h2 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: #1e3c72;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .service-card {
