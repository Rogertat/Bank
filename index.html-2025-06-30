  <script>

  

  function performSearch() {
    const searchTerm = document.getElementById("searchInput").value.trim().toLowerCase();

    // Mapping of keywords to page names
    const pageMap = {
      "home": "index.html",
      "services": "services.html",
      "account": "account.html",
      "contact": "contact.html",
      "login": "login.html"
    };

    // Check if search term matches any key
    if (searchTerm && pageMap[searchTerm]) {
      window.location.href = `${pageMap[searchTerm]}?search=${encodeURIComponent(searchTerm)}`;

    } else if (searchTerm) {
      // Show no result message
      alert(`No results found for: "${searchTerm}"`);

      // Push to adobeDataLayer
      window.adobeDataLayer.push({
        event: "searcheswithoutResult",
        searches: {
          withoutResult: searchTerm
        }
      });
    }
  }



    const slides = document.getElementById('carouselSlides');
    const dots = document.querySelectorAll('.carousel-dot');
    let currentSlide = 0;
    let totalSlides = dots.length;

    function showSlide(index) {
      slides.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach(dot => dot.classList.remove('active'));
      dots[index].classList.add('active');
      currentSlide = index;
    }

    function goToSlide(index) {
      showSlide(index);
    }

    function autoSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    setInterval(autoSlide, 5000);
    showSlide(0); // initialize
	
	
  </script>
